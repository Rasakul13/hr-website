# Apache-Konfiguration für netcup-Webhosting

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS und www erzwingen
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.heidirast.com%{REQUEST_URI} [L,R=301]

  # Alte Jimdo-Adressen auf die neuen Seiten umleiten
  RewriteRule ^\xC3\xBCber-mich/meine-b\xC3\xBCcher/?$ /ueber-mich/buecher/ [L,R=301]
  RewriteRule ^\xC3\xBCber-mich/?$ /ueber-mich/ [L,R=301]
  RewriteRule ^meine-methoden/?$ /methoden/ [L,R=301]
  RewriteRule ^angebote-1/?$ /angebote/ [L,R=301]
  RewriteRule ^erfahrungen-erlebnisse/?$ /erfahrungen/ [L,R=301]
  RewriteRule ^kontakt-faqs/?$ /kontakt/ [L,R=301]
  RewriteRule ^about/?$ /impressum/ [L,R=301]
  RewriteRule ^j/privacy/?$ /datenschutz/ [L,R=301]
  RewriteRule ^2026/10/17/die-decrees-von-nidhu-b-kapoor /blog/die-decrees-von-nidhu-b-kapoor/ [L,R=301]
  RewriteRule ^sitemap/?$ / [L,R=301]
</IfModule>

# Astro-Assets lange cachen (Dateinamen in /_astro/ enthalten einen Hash)
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
