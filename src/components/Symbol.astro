---
// Goldene Linien-Symbole (Sonne, Blume des Lebens, Kreise, Raute)
interface Props {
  name: 'sun' | 'flower' | 'circles' | 'diamond' | 'figure' | 'hands';
  size?: number;
  /** dicker bei kleinen Icons, damit die Linien sichtbar bleiben */
  strokeWidth?: number;
}

const { name, size = 84, strokeWidth = 1.2 } = Astro.props;
---

<svg
  class="symbol"
  width={size}
  height={size}
  viewBox="0 0 80 80"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'sun' && (
      <>
        <circle cx="40" cy="40" r="12" />
        <path d="M40 6v14M40 60v14M6 40h14M60 40h14M16 16l10 10M54 54l10 10M64 16L54 26M26 54L16 64" />
      </>
    )
  }
  {
    name === 'flower' && (
      <>
        <circle cx="40" cy="40" r="12" />
        <circle cx="40" cy="28" r="12" />
        <circle cx="40" cy="52" r="12" />
        <circle cx="29.6" cy="34" r="12" />
        <circle cx="50.4" cy="34" r="12" />
        <circle cx="29.6" cy="46" r="12" />
        <circle cx="50.4" cy="46" r="12" />
        <circle cx="40" cy="40" r="26" />
      </>
    )
  }
  {
    name === 'circles' && (
      <>
        <circle cx="40" cy="40" r="30" />
        <circle cx="40" cy="40" r="20" />
        <circle cx="40" cy="40" r="10" />
        <circle cx="40" cy="40" r="2.5" fill="currentColor" />
      </>
    )
  }
  {
    name === 'figure' && (
      <>
        <circle cx="40" cy="16" r="8" />
        <path d="M16 30c8 6 16 8 24 8s16-2 24-8" />
        <path d="M40 38v16M40 54L28 72M40 54l12 18" />
      </>
    )
  }
  {
    name === 'hands' && (
      <>
        <path d="M14 46c6 12 16 20 26 20s20-8 26-20" />
        <path d="M14 46l4-14 6 10M66 46l-4-14-6 10" />
        <path d="M40 10v10M40 34v2M28 18l5 6M52 18l-5 6" />
        <circle cx="40" cy="28" r="4" />
      </>
    )
  }
  {
    name === 'diamond' && (
      <>
        <path d="M40 8 L68 40 L40 72 L12 40 Z" />
        <path d="M40 22 L54 40 L40 58 L26 40 Z" />
        <path d="M12 40h56M40 8v64" />
      </>
    )
  }
</svg>

<style>
  .symbol {
    color: var(--gold);
  }
</style>
