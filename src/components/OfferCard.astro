---
import { Image } from 'astro:assets';
import type { Offer } from '../data/offers';

interface Props {
  offer: Offer;
  dark?: boolean;
}

const { offer, dark = false } = Astro.props;
const external = offer.cta.href.startsWith('http');
---

<article id={offer.id} class:list={['offer', dark ? 'card-dark' : 'card']}>
  <div class="offer-media">
    <Image src={offer.image} alt={offer.imageAlt} widths={[360, 720]} sizes="(max-width: 760px) 100vw, 320px" />
  </div>

  <div class="offer-body stack">
    <header class="offer-head">
      {offer.meta && <p class="kicker">{offer.meta}</p>}
      <h3>{offer.title}</h3>
      <p class="offer-sub">{offer.subtitle}</p>
    </header>

    {offer.text.map((p) => <p set:html={p} />)}

    <div class="offer-lists">
      <div>
        <h4>Geeignet für</h4>
        <ul class="sparkle-list">{offer.suitable.map((s) => <li>{s}</li>)}</ul>
      </div>
      {
        offer.includes && (
          <div>
            <h4>Die Intensivbegleitung beinhaltet</h4>
            <ul class="sparkle-list">{offer.includes.map((s) => <li>{s}</li>)}</ul>
          </div>
        )
      }
    </div>

    {offer.note && <p class="offer-note">{offer.note}</p>}

    <footer class="offer-foot">
      <p class="offer-claim">{offer.claim}</p>
      <a href={offer.cta.href} class:list={['btn', dark ? 'btn-gold' : 'btn-petrol']} rel={external ? 'noopener' : undefined}>
        {offer.cta.label}
      </a>
    </footer>
  </div>
</article>

<style>
  .offer {
    display: grid;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 48px);
    padding: clamp(22px, 3vw, 40px);
    scroll-margin-top: 24px;
  }

  .offer-media :global(img) {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 18px;
  }

  .offer-head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .offer-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 21px;
    color: var(--ink-soft);
  }

  .card-dark .offer-sub {
    color: var(--gold-light);
  }

  .offer-lists {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
  }

  h4 {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-ink);
    margin-bottom: 12px;
  }

  .card-dark h4 {
    color: var(--gold);
  }

  .sparkle-list {
    font-size: 16px;
  }

  .offer-note {
    font-size: 15px;
    color: var(--ink-soft);
  }

  .card-dark .offer-note,
  .card-dark .offer-body > p {
    color: var(--on-dark-soft);
  }

  /* Spruch links, Buchen-Button immer rechts – auch wenn der Spruch zweizeilig ist */
  .offer-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px 24px;
    padding-top: 20px;
    border-top: 1px solid var(--gold-line);
  }

  .offer-foot .btn {
    justify-self: end;
  }

  .offer-claim {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 22px;
    line-height: 1.3;
    max-width: 460px;
  }

  @media (max-width: 520px) {
    .offer-foot {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 760px) {
    .offer {
      grid-template-columns: minmax(0, 1fr);
    }

    .offer-media {
      max-width: 360px;
    }
  }
</style>
