---
import Sparkle from './Sparkle.astro';

interface Props {
  title: string;
  quote: string;
  context?: string;
}

const { title, quote, context } = Astro.props;
---

<figure class="testimonial">
  <span class="badge" aria-hidden="true">
    <svg viewBox="0 0 32 24" width="22" height="17">
      <path
        d="M0 24V13.7C0 5.9 4.3 1.3 12.6 0l1.3 3.2C9.3 4.6 7.1 7.4 6.9 11.2H13V24H0Zm18.4 0V13.7C18.4 5.9 22.7 1.3 31 0l1.3 3.2c-4.6 1.4-6.8 4.2-7 8h6.1V24H18.4Z"
        fill="currentColor"></path>
    </svg>
  </span>

  {context && <p class="context">{context}</p>}
  <blockquote>{quote}</blockquote>

  <figcaption>
    <Sparkle size={12} color="#cdaa5e" />
    {title}
  </figcaption>
</figure>

<style>
  .testimonial {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 34px 32px 26px;
    background: var(--paper);
    border: 1px solid rgba(205, 170, 94, 0.22);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    break-inside: avoid;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--petrol);
    color: var(--gold);
    outline: 1px solid var(--gold-line);
    outline-offset: 6px;
    margin: 6px 0 6px 6px;
  }

  .context {
    font-size: 15px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 24px;
    line-height: 1.45;
    color: var(--ink);
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--gold-line);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-ink);
  }
</style>
