---
import SoftImage from '../../components/SoftImage.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import buchNacken from '../../assets/images/buch-nacken.jpg';
import buchMandala from '../../assets/images/buch-mandala.jpg';

// Texte 1:1 von heidirast.com/über-mich/meine-bücher/
const books = [
  {
    title: 'Nackenprobleme? Schmerzen? Verspannungen?',
    image: buchNacken,
    alt: 'Buch „Der Nacken im Fokus“ von Heidi Rast',
    text: [
      'Dieser Praxisratgeber hilft Dir, die wahren Ursachen zu verstehen – weit über Stress oder langes Sitzen hinaus. Die erfahrene Physiotherapeutin Heidi Rast erklärt verständlich die Zusammenhänge zwischen Muskeln, Organen und Emotionen. So kannst Du Nacken- und Kopfschmerzen an der Wurzel packen und gezielt lösen.',
      'Im zweiten Teil erwarten Dich praktische Übungen und Tipps für akute und chronische Beschwerden.',
    ],
    claim: 'Nimm Deine Gesundheit selbst in die Hand!',
    href: 'https://amzn.eu/d/9QdCK5Y',
  },
  {
    title: 'Entspannung, Kreativität & Achtsamkeit – mit Mandalas!',
    image: buchMandala,
    alt: 'Buch „Energiebilder – Mandalas“ von Heidi Rast',
    text: [
      'Dieses Buch lädt Dich ein, in die meditative Kunst des Mandala-Ausmalens einzutauchen. Jedes Motiv wurde sorgfältig gestaltet, um Dich zu inspirieren und Aspekte wie <strong>Ruhe, Harmonie, Gesundheit, Liebe und Fülle</strong> zu stärken.',
      'Lass den Alltag hinter Dir, finde Deinen kreativen Flow und genieße die beruhigende Wirkung der Muster – ganz ohne Regeln, nur mit Deinen Lieblingsfarben.',
    ],
    claim: 'Perfekt zum Abschalten – auch als Geschenk!',
    href: 'https://amzn.eu/d/ivjWb2e',
  },
];
---

<BaseLayout title="Meine Bücher" description="Bücher von Heidi Rast: Praxisratgeber für Nacken und Kopf und ein Mandala-Malbuch.">
  <PageHero kicker="Über mich" title="Meine Bücher" compact />

  <section class="section bg-cream">
    <div class="container books">
      {
        books.map((b, i) => (
          <article class:list={['book card', { flip: i % 2 === 1 }]}>
            <SoftImage src={b.image} alt={b.alt} widths={[420, 840]} sizes="(max-width: 820px) 100vw, 460px" />
            <div class="stack">
              <h2>{b.title}</h2>
              {b.text.map((p) => <p set:html={p} />)}
              <p class="claim">{b.claim}</p>
              <div class="btn-row">
                <a href={b.href} class="btn btn-petrol" rel="noopener">Mehr erfahren</a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .books {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .book {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(24px, 5vw, 64px);
    padding: clamp(22px, 3vw, 40px);
  }

  .book.flip > :global(.soft-image) {
    order: 2;
  }

  .book :global(.soft-image) {
    border-radius: 18px;
  }

  h2 {
    font-size: clamp(28px, 3.2vw, 40px);
  }

  .claim {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 24px;
    color: var(--petrol-soft);
  }

  @media (max-width: 820px) {
    .book {
      grid-template-columns: minmax(0, 1fr);
    }

    .book.flip > :global(.soft-image) {
      order: 0;
    }
  }
</style>
