---
import { url } from '../../utils/url';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Sparkle from '../../components/Sparkle.astro';
import Symbol from '../../components/Symbol.astro';
import heidi from '../../assets/images/heidi.png';
import buchNacken from '../../assets/images/buch-nacken.jpg';
import buchMandala from '../../assets/images/buch-mandala.jpg';
import { mailto, site } from '../../data/site';

const toolbox = [
  { name: 'Body Code & Emotion Code', text: 'Lösen tiefsitzender Blockaden' },
  { name: 'Saturn’s Decrees & Ein-Sekunden-Alchemie', text: 'Transformative Energie in kürzester Zeit' },
  { name: 'Reiki & Light Keys System', text: 'Heilung durch universelle Energie' },
  { name: 'Energetische Wirbelsäulenaufrichtung & Facelifting', text: 'Für körperliches und energetisches Gleichgewicht' },
  { name: 'Radionik & Plejadenstrahl-Technologie', text: 'Arbeiten mit Frequenzen und Informationsfeldern' },
  { name: 'Akashic Records Readings', text: 'Antworten aus der Ebene des höheren Wissens' },
];

const qualifications = [
  { symbol: 'figure', label: 'Physiotherapeutin' },
  { symbol: 'hands', label: 'Reiki-Meisterin und -Lehrerin' },
  { symbol: 'circles', label: 'Certified Body Code Practitioner' },
] as const;

const online = [
  'Keine langen Anfahrten',
  'Flexible Terminmöglichkeiten, auch abends oder am Wochenende',
  'Heilung in Deinem vertrauten Umfeld',
];
---

<BaseLayout title="Über mich" description="Heidi Rast: über 35 Jahre Erfahrung – von der Physiotherapie zur energetischen Heilarbeit.">
  <PageHero kicker="Über mich" title="Meine Reise zur energetischen Heilarbeit" />

  <section class="section bg-cream">
    <div class="container intro-grid">
      <div class="portrait">
        <Image src={heidi} alt="Heidi Rast" widths={[320, 640]} sizes="(max-width: 820px) 70vw, 380px" />
      </div>
      <div class="stack">
        <p class="lead">
          Ich bin Heidi Rast, und seit über 35 Jahren begleite ich Menschen auf ihrem Weg zu mehr Wohlbefinden. Meine
          Reise begann als Physiotherapeutin – mit einem klaren Fokus auf Verstand, Logik und den physischen Körper.
          Doch im Laufe der Jahre wurde mir immer bewusster, dass wahre Heilung mehr erfordert als das, was man sehen
          oder messen kann.
        </p>
        <ul class="quals">
          {
            qualifications.map((q) => (
              <li>
                <span class="qual-icon">
                  <Symbol name={q.symbol} size={22} strokeWidth={4} />
                </span>
                {q.label}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section bg-paper">
    <div class="container narrow stack">
      <h2>Von der klassischen Therapie zur <em>energetischen Heilung</em></h2>
      <p>
        Anfangs ging es um Muskeln, Gelenke und manuelle Techniken. Doch je tiefer ich in meine Arbeit eintauchte, desto
        deutlicher wurde: Körperliche Beschwerden haben oft tiefere, verborgene Ursachen. Emotionale Blockaden, unbewusste
        Muster und energetische Störungen beeinflussen unsere Gesundheit und unser Leben weit mehr, als wir ahnen.
      </p>
      <p>
        So begann ich, über den Tellerrand hinauszublicken. Ich erlernte kinesiologische Methoden wie <em>Touch for
        Health</em> und <em>Edukinesthetik</em> und wurde Reiki-Meisterin und -Lehrerin. Doch damit hörte meine Neugier
        nicht auf. Ich erforschte Klangschalen-Massage, Chakren-Balance, Pranic Healing, Japanisches Heilströmen und
        viele weitere energetische Techniken – immer mit einem Ziel: schneller, effektiver und nachhaltiger zu helfen.
      </p>
    </div>
  </section>

  <section class="section bg-petrol">
    <div class="container stack">
      <div class="narrow stack">
        <p class="kicker">Werkzeugkoffer</p>
        <h2>Mein Werkzeugkoffer für energetische Heilung</h2>
        <p class="muted">
          Mit den Jahren entwickelte ich eine einzigartige Kombination aus bewährten Methoden und modernen energetischen
          Techniken. Heute arbeite ich unter anderem mit:
        </p>
      </div>
      <ul class="toolbox">
        {
          toolbox.map((t) => (
            <li class="card-dark">
              <Sparkle size={18} color="#cdaa5e" />
              <h3>{t.name}</h3>
              <p class="muted">{t.text}</p>
            </li>
          ))
        }
      </ul>
      <p><a href={url("/methoden/")}>Alle Methoden ausführlich erklärt →</a></p>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="container online-grid">
      <div class="stack">
        <h2>Warum ich heute ausschließlich <em>online</em> arbeite</h2>
        <p>
          Nach 40 Jahren in der Praxis habe ich mich bewusst entschieden, meine Behandlungen nur noch als Fernsessions
          anzubieten. Denn Energie kennt keine Distanz – und oft wirken Heilimpulse auf diesem Weg sogar noch schneller und
          tiefer. Die Vorteile für dich liegen auf der Hand:
        </p>
      </div>
      <ul class="sparkle-list online-list card">
        {online.map((o) => <li>{o}</li>)}
      </ul>
    </div>
  </section>

  <section class="section bg-cream-dark">
    <div class="container books">
      <div class="stack">
        <p class="kicker">Meine Bücher</p>
        <h2>Gesundheit selbst in die Hand nehmen</h2>
        <p class="muted">Ein Praxisratgeber für Nacken und Kopf – und ein Mandala-Malbuch für Ruhe, Harmonie und Fülle.</p>
        <a href={url("/ueber-mich/buecher/")} class="btn btn-outline">Zu meinen Büchern</a>
      </div>
      <div class="book-covers">
        <Image src={buchNacken} alt="Buch: Der Nacken im Fokus" widths={[320, 640]} sizes="(max-width: 820px) 45vw, 280px" />
        <Image src={buchMandala} alt="Buch: Energiebilder – Mandalas" widths={[320, 640]} sizes="(max-width: 820px) 45vw, 280px" />
      </div>
    </div>
  </section>

  <CtaBand
    title="Bist Du bereit, Deine Blockaden zu lösen?"
    text="Ich lade Dich ein, die Kraft der energetischen Heilung selbst zu erfahren. Egal, ob es um körperliche Beschwerden, emotionale Herausforderungen oder Business-Themen geht – ich öffne Türen, die bislang verschlossen waren."
    primary={{ label: 'Heilsession buchen', href: site.heilsession }}
    secondary={{ label: 'Hilfe bei der Auswahl', href: mailto }}
  />
</BaseLayout>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
  }

  .portrait {
    max-width: 400px;
    justify-self: center;
  }

  .portrait :global(img) {
    width: 100%;
    border-radius: 50%;
  }

  .quals {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .quals li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 18px 6px 6px;
    background: var(--paper);
    border: 1px solid var(--gold-line);
    border-radius: 999px;
    font-size: 15px;
    line-height: 1.3;
    color: var(--ink-soft);
  }

  .qual-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--petrol);
  }

  .toolbox {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 18px;
  }

  .toolbox li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px;
  }

  .toolbox h3 {
    font-size: 24px;
  }

  .online-grid,
  .books {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }

  .online-list {
    padding: 32px;
    font-size: 19px;
    border: 1px solid var(--gold-line);
  }

  .book-covers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .book-covers :global(img) {
    width: 100%;
    border-radius: 18px;
    box-shadow: var(--shadow);
  }

  @media (max-width: 820px) {
    .intro-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      max-width: 280px;
    }
  }
</style>
