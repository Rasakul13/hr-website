---
import { url } from '../../utils/url';
import SoftImage from '../../components/SoftImage.astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('de-AT', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title="Blog" description="Artikel von Heidi Rast über energetische Heilarbeit, Decrees und Heilfrequenzen.">
  <PageHero kicker="Blog" title="Gedanken aus meiner Praxis" compact />

  <section class="section bg-cream">
    <div class="container posts">
      {
        posts.map((post) => (
          <article class="card post">
            <a href={url(`/blog/${post.id}/`)} class="post-img" tabindex="-1" aria-hidden="true">
              <SoftImage src={post.data.cover} alt="" widths={[480, 960]} sizes="(max-width: 820px) 100vw, 520px" />
            </a>
            <div class="stack">
              <p class="kicker">
                {post.data.category && `${post.data.category} · `}
                <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
              </p>
              <h2>
                <a href={url(`/blog/${post.id}/`)}>{post.data.title}</a>
              </h2>
              <p class="muted">{post.data.description}</p>
              <a href={url(`/blog/${post.id}/`)} class="more">Weiterlesen →</a>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .posts {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    padding: clamp(20px, 3vw, 32px);
  }

  .post-img :global(.soft-image) {
    border-radius: 18px;
  }

  h2 {
    font-size: clamp(28px, 3vw, 40px);
  }

  h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--petrol-soft);
  }

  .more {
    font-weight: 500;
  }

  @media (max-width: 820px) {
    .post {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
