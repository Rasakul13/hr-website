---
import { url } from '../../utils/url';
import SoftImage from '../../components/SoftImage.astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { mailto } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('de-AT', { day: 'numeric', month: 'long', year: 'numeric' });
const kicker = [post.data.category, fmt.format(post.data.date)].filter(Boolean).join(' · ');
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <PageHero kicker={kicker} title={post.data.title} compact />

  <article class="section bg-paper">
    <div class="container narrow">
      <figure class="cover">
        <SoftImage src={post.data.cover} alt={post.data.coverAlt} widths={[780, 1560]} sizes="(max-width: 860px) 100vw, 780px" priority />
        {post.data.coverNote && <figcaption>{post.data.coverNote}</figcaption>}
      </figure>
      <div class="prose">
        <Content />
      </div>
      <p class="back"><a href={url("/blog/")}>← Alle Artikel</a></p>
    </div>
  </article>

  <CtaBand
    title="Darf ich Dich auf Deiner Heilreise begleiten?"
    primary={{ label: 'Zu den Angeboten', href: '/angebote/' }}
    secondary={{ label: 'E-Mail schreiben', href: mailto }}
  />
</BaseLayout>

<style>
  .cover {
    margin: 0 0 40px;
  }

  .cover :global(.soft-image) {
    border-radius: 20px;
  }

  figcaption {
    margin-top: 8px;
    font-size: 13px;
    color: var(--ink-soft);
  }

  .back {
    margin-top: 48px;
    font-weight: 500;
  }
</style>
