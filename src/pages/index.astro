---
import { url } from '../utils/url';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Bokeh from '../components/Bokeh.astro';
import Mandala from '../components/Mandala.astro';
import Sparkle from '../components/Sparkle.astro';
import Symbol from '../components/Symbol.astro';
import CtaBand from '../components/CtaBand.astro';
import Testimonial from '../components/Testimonial.astro';
import SoftImage from '../components/SoftImage.astro';
import glitzer from '../assets/images/glitzer.jpg';
import introBild from '../assets/images/intro-licht.png';
import { mailto, site } from '../data/site';
import { testimonials } from '../data/content';

const examples = [
  'Eine Verkäuferin mit Flaute bekommt am nächsten Tag neue Aufträge.',
  'Ein lange stagnierender Hausverkauf kommt plötzlich in Bewegung.',
  'Prüfungen, OPs oder schwierige Gespräche verlaufen mit neuer Leichtigkeit.',
  'Langjährige Ängste oder Unsicherheiten lösen sich sanft auf.',
];

const formats = [
  { symbol: 'sun', title: 'Einzelsitzungen', text: 'Für schnelle energetische Klärung', href: '/angebote/#heilsession' },
  { symbol: 'flower', title: 'Monatliche Begleitung', text: 'Für tiefgreifende Veränderungen', href: '/angebote/#intensivbegleitung' },
  { symbol: 'diamond', title: 'Business-Heilung', text: 'Energiearbeit für Unternehmer und Projekte', href: '/angebote/#business-begleitung' },
  { symbol: 'circles', title: 'Frauenspezifische Themen', text: 'Unerfüllter Kinderwunsch, hormonelle Balance, Partnerschaft', href: '/angebote/#intensivbegleitung' },
] as const;

const quotes = testimonials.filter((t) => !t.hidden).slice(0, 3);
---

<BaseLayout>
  <!-- Hero -->
  <section class="home-hero bg-petrol">
    <Image src={glitzer} alt="" class="hero-glitter fade-in" widths={[800, 1600]} sizes="100vw" loading="eager" />
    <Bokeh />
    <div class="container hero-grid">
      <div class="stack hero-text">
        <p class="kicker">Heidi Rast · Magische Heilerin</p>
        <h1>Heilung auf energetischer Ebene <em>Deine magische Reise beginnt hier</em></h1>
        <p class="lead muted">{site.tagline}.</p>
        <div class="btn-row">
          <a href={url("/angebote/")} class="btn btn-gold">Angebote entdecken</a>
          <a href={mailto} class="btn btn-ghost">E-Mail schreiben</a>
        </div>
      </div>
      <div class="hero-mandala">
        <div class="hero-glow" aria-hidden="true"></div>
        <Mandala spin />
      </div>
    </div>
  </section>

  <!-- Blockaden + Vorstellung -->
  <section class="section bg-cream">
    <div class="container intro-grid">
      <div class="portrait">
        <svg class="portrait-ring" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
          <circle cx="200" cy="200" r="198.5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="1.5 6" stroke-linecap="round"></circle>
        </svg>
        <div class="portrait-frame">
          <SoftImage src={introBild} alt="Frau mit geschlossenen Augen in hellem, warmem Licht" />
        </div>
      </div>
      <div class="stack">
        <h2 class="intro-title">
          Spürst Du, dass etwas blockiert ist
          <span class="intro-sub">– in Deinem Leben, Deinem Business oder Deinen Beziehungen?</span>
        </h2>
        <p>
          Vielleicht drehen sich Deine Gedanken im Kreis, Deine Energie ist erschöpft oder es fühlt sich an, als ob Du
          gegen unsichtbare Mauern läufst. Es gibt Dinge, die sich mit dem Verstand nicht lösen lassen – aber auf
          energetischer Ebene kann Heilung geschehen.
        </p>
        <p>
          Ich bin Heidi Rast, magische Heilerin, und begleite Dich mit kraftvollen energetischen Methoden. Ohne
          Coaching, ohne Ratschläge – nur reine, tiefgreifende Energiearbeit. Ich öffne Türen, die bisher für Dich
          verschlossen waren.
        </p>
        <a href={url("/ueber-mich/")} class="more">Meine Reise zur energetischen Heilarbeit <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Licht -->
  <section class="section bg-petrol light-section">
    <Bokeh mirror />
    <div class="container light-grid">
      <div class="stack">
        <h2>Was wäre, wenn sich Dein Problem in <em>Licht auflösen</em> könnte?</h2>
        <p class="muted">
          Ob gesundheitliche Beschwerden, emotionale Belastungen, berufliche Herausforderungen oder Beziehungsthemen –
          oft sind es unbewusste Blockaden, die uns zurückhalten. Durch energetische Impulse lösen sich diese Muster auf,
          und Veränderung geschieht auf natürliche Weise.
        </p>
      </div>
      <ul class="examples">
        {
          examples.map((e) => (
            <li class="card-dark">
              <Sparkle size={20} color="#e6cc8f" />
              <span>{e}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Begleitung -->
  <section class="section bg-cream">
    <div class="container stack">
      <div class="narrow stack center">
        <p class="kicker">Meine Arbeit</p>
        <h2>Wie funktioniert die energetische Begleitung?</h2>
        <p class="muted">
          Ich arbeite mit verschiedenen Heilmethoden – Body Code, Heilfrequenzen, Reiki, Watteheilung, Heilsymbole und
          viele weitere Techniken. Alles geschieht sanft, oft sogar aus der Ferne. Du musst nichts tun – nur bereit
          sein, den Wandel zuzulassen.
        </p>
      </div>
      <div class="formats">
        {
          formats.map((f) => (
            <a href={url(f.href)} class="format card">
              <span class="format-symbol">
                <Symbol name={f.symbol} />
              </span>
              <span class="format-body">
                <span class="format-title">{f.title}</span>
                <span class="format-text">{f.text}</span>
              </span>
            </a>
          ))
        }
      </div>
      <p class="center"><a href={url("/methoden/")} class="more">Alle Methoden im Überblick <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- Erfahrungen -->
  <section class="section bg-cream-dark">
    <div class="container stack">
      <h2 class="center">Erfahrungen & Erlebnisse</h2>
      <div class="quotes">
        {quotes.map((t) => <Testimonial title={t.title} quote={t.quote} />)}
      </div>
      <p class="center"><a href={url("/erfahrungen/")} class="more">Alle Erfahrungen lesen <span class="arrow" aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <CtaBand
    title="Darf ich Dich auf Deiner Heilreise begleiten?"
    text="Am schnellsten geht die Buchung über meinen Onlineshop. Damit die Energie bald bei dir ankommt!"
    primary={{ label: 'Zum Shop', href: site.shop }}
    secondary={{ label: 'Termin per E-Mail anfragen', href: mailto }}
  />
</BaseLayout>

<style>
  /* Hero */
  .home-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(56px, 9vw, 130px);
  }

  .home-hero :global(.hero-glitter) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.18;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .hero-text {
    gap: 26px;
  }

  h1 em {
    display: block;
    margin-top: 0.15em;
    font-size: 0.72em;
  }

  .hero-mandala {
    position: relative;
    width: 100%;
    max-width: 520px;
    justify-self: center;
  }

  .hero-glow {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(143, 211, 216, 0.3) 0%, rgba(143, 211, 216, 0) 70%);
  }

  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-mandala {
      max-width: 300px;
      order: -1;
    }
  }

  /* Intro */
  .intro-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 88px);
  }

  /* Rundes Bild mit feinem Goldring wie bei „Ablauf & Buchung“, dazu ein gepunkteter
     Außenring. Breite bleibt unter der Originalgröße des Bildes (331px), damit es scharf bleibt. */
  .portrait {
    position: relative;
    width: clamp(260px, 28vw, 360px);
    padding: 14px;
  }

  .portrait-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: var(--gold);
  }

  .portrait-frame {
    border: 1px solid var(--gold-line);
    border-radius: 50%;
    padding: 10px;
  }

  .portrait :global(.soft-image) {
    border-radius: 50%;
    /* nimmt dem Bild den kühlen Lila-Stich, auch der Vorschau */
    filter: sepia(0.22) saturate(0.95) brightness(1.02);
  }

  .portrait :global(img) {
    display: block;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .intro-title {
    font-size: clamp(32px, 3.6vw, 46px);
  }

  .intro-sub {
    display: block;
    margin-top: 0.55em;
    font-size: clamp(20px, 1.9vw, 24px);
    font-style: italic;
    font-weight: 400;
    line-height: 1.35;
    color: var(--ink-soft);
  }

  .more {
    font-weight: 500;
    color: var(--petrol-soft);
    text-decoration-color: var(--gold-line);
    transition:
      color 0.2s ease,
      text-decoration-color 0.2s ease;
  }

  .more:hover {
    color: var(--gold-ink);
    text-decoration-color: var(--gold);
  }

  .more .arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .more:hover .arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .more .arrow {
      transition: none;
    }
  }

  @media (max-width: 820px) {
    .intro-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      width: 280px;
      justify-self: center;
    }
  }

  /* Licht */
  .light-section {
    position: relative;
    overflow: hidden;
  }

  .light-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }

  .examples {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 14px;
  }

  .examples li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px 24px;
    font-size: 17px;
  }

  .examples :global(svg) {
    flex-shrink: 0;
    margin-top: 4px;
  }

  /* Formate */
  .formats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-top: 12px;
  }

  .format {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.2s;
  }

  .format:hover {
    transform: translateY(-3px);
    color: var(--ink);
  }

  .format-symbol {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 150px;
    background: var(--petrol);
  }

  .format-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px;
  }

  .format-title {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.15;
  }

  .format-text {
    color: var(--ink-soft);
    font-size: 16px;
  }

  /* Zitate */
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 16px;
  }
</style>
